# Copy to deploy/.env on the ECS and run: chmod 600 deploy/.env
OMNI_ENVIRONMENT=production
OMNI_LOG_LEVEL=INFO
OMNI_PUBLIC_BASE_URL=http://10.8.0.1

# Generate both values independently, for example: openssl rand -hex 32
OMNI_JWT_SECRET=replace-with-a-random-secret
OMNI_DEVICE_ENROLLMENT_TOKEN=replace-with-a-low-privilege-enrollment-token
OMNI_DEVICE_TOKEN_TTL_SECONDS=43200

# DashScope secrets exist only on the ECS.
OMNI_DASHSCOPE_API_KEY=replace-with-dashscope-api-key
OMNI_DASHSCOPE_WORKSPACE_ID=replace-with-workspace-id
OMNI_DASHSCOPE_ENDPOINT_HOST=cn-beijing.maas.aliyuncs.com
OMNI_DASHSCOPE_MODEL=qwen3.5-omni-flash-realtime

# OBS uses the ECS IAM agency in production. Do not add permanent AK/SK here.
OMNI_OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com
OMNI_OBS_DATA_BUCKET=replace-with-private-data-bucket
OMNI_OBS_RELEASE_BUCKET=replace-with-private-release-bucket
OMNI_OBS_SIGNED_URL_TTL_SECONDS=900
OMNI_MAX_UPLOAD_BYTES=536870912

POSTGRES_PASSWORD=replace-with-a-random-database-password
